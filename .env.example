OPENAI_API_KEY=

# LLM labeling budget guard. The script blocks before a request if the next
# estimated call would reach the soft cap. Defaults are intentionally conservative.
LLM_LABEL_BUDGET_USD=100
LLM_LABEL_SOFT_BUDGET_USD=95
LLM_LABEL_MODEL=gpt-4o-mini
LLM_LABEL_INPUT_USD_PER_1M=5
LLM_LABEL_OUTPUT_USD_PER_1M=20
LLM_LABEL_REQUEST_OVERHEAD_USD=0
LLM_LABEL_IMAGE_INPUT_TOKENS=1700
LLM_LABEL_IMAGE_DETAIL=low
